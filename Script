const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

function clamp(v, min, max){ return Math.min(max, Math.max(min, v)); }

// Active nav link for current page
const currentPage = document.body.dataset.page;
document.querySelectorAll('.nav-links a').forEach(a => {
  if (a.dataset.page === currentPage) a.classList.add('active');
});

if (!reduce){
  const bubbles = Array.from(document.querySelectorAll('[data-bubble]'));
  const reveals = Array.from(document.querySelectorAll('.reveal'));

  const io = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('is-visible'); });
  }, { threshold: 0.16, rootMargin: '0px 0px -10% 0px' });
  reveals.forEach(el => io.observe(el));

  const blurPast = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--blurPast'));
  const dimPast = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--dimPast'));

  function updatePastBlur(){
    const vh = window.innerHeight;
    const start = vh * 0.10;
    const end = vh * 0.05;

    bubbles.forEach(b => {
      const r = b.getBoundingClientRect();
      const t = (start - r.bottom) / (start - end);
      const p = clamp(t, 0, 1);
      b.style.setProperty('--b', (p * blurPast).toFixed(2) + 'px');
      b.style.setProperty('--o', (1 - p * (1 - dimPast)).toFixed(3));
    });
  }

  function onScrollFlow(){
    const vh = window.innerHeight;
    bubbles.forEach(el => {
      const r = el.getBoundingClientRect();
      const mid = r.top + r.height / 2;
      const t = (mid - vh / 2) / vh;
      const y = clamp(t * 6, -6, 6);
      el.style.setProperty('--fy', y.toFixed(2) + 'px');
    });
    updatePastBlur();
  }

  let ticking = false;
  function onScroll(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { onScrollFlow(); ticking = false; });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });
  onScrollFlow();
} else {
  document.querySelectorAll('.reveal').forEach(el => el.classList.add('is-visible'));
}
